# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_transport_dev?schema=public

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=school-transport-api
JWT_AUDIENCE=school-transport-clients

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Swagger
SWAGGER_ENABLED=true

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Firebase (optional - add when available)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Google Maps (optional)
# GOOGLE_MAPS_API_KEY=
