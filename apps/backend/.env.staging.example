# Application
NODE_ENV=staging
APP_ENV=staging
PORT=3000
API_PREFIX=api/v1

# Database (Staging isolated DB)
DATABASE_URL=postgresql://staging_user:staging_pass@db-host:5432/school_transport_staging?schema=public

# JWT Security
JWT_ACCESS_SECRET=your-secure-staging-access-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your-secure-staging-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRY=7d

# CORS (Allow only staging frontends)
CORS_ORIGINS=https://school-staging.example.com,https://admin-staging.example.com,https://staging.example.com

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Swagger (Disable in external staging or protect it)
SWAGGER_ENABLED=false

# URLs for Email links / Cross-app linking
PUBLIC_WEBSITE_URL=https://staging.example.com
SCHOOL_DASHBOARD_URL=https://school-staging.example.com
PLATFORM_ADMIN_URL=https://admin-staging.example.com

# Redis (For queues / sockets)
REDIS_URL=redis://redis-staging-host:6379

# Firebase (For notifications - Use staging project)
# FIREBASE_PROJECT_ID=school-transport-staging-xyz
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-staging@...
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Maps Server Key (Backend geocoding/distance matrix)
# GOOGLE_MAPS_SERVER_API_KEY=AIzaSy...

# SMTP / SendGrid (Staging mailer)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=...
